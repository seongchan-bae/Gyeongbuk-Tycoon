    - {fileID: 543519275}
  - label: "\uAE30\uBCF8 \uAC74\uBB3C \uD0ED"
    section: "\uC0C1\uC810"
    target: {fileID: 1335578025}
    description: "<b>\uAE30\uBCF8 \uAC74\uBB3C \uD0ED</b>\n\uACE8\uB4DC\uB97C \uBC8C\uC5B4 \uC8FC\uB294 \uC77C\uBC18 \uAC74\uBB3C\uC774\uC5D0\uC694. \uAC19\uC740 \uAC74\uBB3C\uC744 \uC5EC\uB7EC \uCC44 \uBC18\uBCF5\uD574\uC11C \uC9C0\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate:
