  - label: "\uAE30\uBCF8 \uAC74\uBB3C \uAC1C\uC218"
    section: "\uC0C1\uC810"
    target: {fileID: 1287763184}
    description: "<b>\uAE30\uBCF8 \uAC74\uBB3C \uAC1C\uC218</b>\n'\uC9C0\uC740 \uAC1C\uC218 / \uC9C0\uC744 \uC218 \uC788\uB294 \uCD5C\uB300 \uAC1C\uC218'\uC608\uC694. \uB2E8\uACC4\uAC00 \uC624\uB974\uBA74 \uCD5C\uB300 \uAC1C\uC218\uAC00 10 \u2192 20 \u2192 30 \u2192 40\uC73C\uB85C \uB298\uC5B4\uB0A9\uB2C8\uB2E4. \uAF49 \uCC28\uBA74 \uAE30\uBCF8 \uAC74\uBB3C\uC740 \uB354 \uC0B4 \uC218 \uC5C6\uC5B4\uC694."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 1150707393}
    - {fileID: 653334741}
    deactivate:
    - {fileID: 1222384153}
    - {fileID: 860797861}
    - {fileID: 633146532}
    - {fileID: 924493836}
  - label: "\uAC74\uBB3C \uCE74\uB4DC"
    section: "\uC0C1\uC810"
    target: {fileID: 1438699196}
    description: "<b>\uAC74\uBB3C \uCE74\uB4DC</b>\n\uAC00\uACA9, \uCD08\uB2F9 \uACE8\uB4DC \uC0DD\uC0B0\uB7C9, \uB298\uC5B4\uB098\uB294 \uAD00\uAD11\uAC1D \uC218\uC640 \uC218\uC6A9 \uD55C\uB3C4, \uD544\uC694\uD55C \uC9C0\uC2DD \uD3EC\uC778\uD2B8\uAC00 \uC801\uD600 \uC788\uC5B4\uC694. \uACE8\uB4DC\uB098 \uC9C0\uC2DD \uD3EC\uC778\uD2B8\uAC00 \uBAA8\uC790\uB77C\uBA74 \uC790\uBB3C\uC1E0\uAC00 \uAC78\uB824 \uC0B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 40}
    activate:
    - {fileID: 1150707393}
    - {fileID: 653334741}
    deactivate:
    - {fileID: 1222384153}
    - {fileID: 860797861}
    - {fileID: 633146532}
    - {fileID: 924493836}
  - label: "\uB79C\uB4DC\uB9C8\uD06C \uD0ED"
    section: "\uC0C1\uC810"
    target: {fileID: 1302341889}
    description: "<b>\uB79C\uB4DC\uB9C8\uD06C \uD0ED</b>\n\uCCA8\uC131\uB300\uCC98\uB7FC \uACBD\uBD81\uC758 \uC2E4\uC81C \uBA85\uC18C\uB97C \uC138\uC6B0\uB294 \uD0ED\uC774\uC5D0\uC694. \uAD00\uAD11\uAC1D\uC744 \uD06C\uAC8C \uB298\uB824 \uC8FC\uC9C0\uB9CC \uC9C0\uC2DD \uD3EC\uC778\uD2B8\uAC00 \uD568\uAED8 \uD544\uC694\uD558\uACE0, \uAC19\uC740 \uB79C\uB4DC\uB9C8\uD06C\uB294 \uD55C \uBC88\uB9CC \uC138\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 1150707393}
    - {fileID: 1222384153}
    deactivate:
    - {fileID: 653334741}
    - {fileID: 860797861}
    - {fileID: 633146532}
    - {fileID: 924493836}
  - label: "\uB79C\uB4DC\uB9C8\uD06C \uCE74\uB4DC"
    section: "\uC0C1\uC810"
    target: {fileID: 1627108015}
    description: "<b>\uB79C\uB4DC\uB9C8\uD06C \uCE74\uB4DC</b>\n\uC774\uBBF8 \uC138\uC6B4 \uB79C\uB4DC\uB9C8\uD06C\uB294 \uC790\uBB3C\uC1E0\uAC00 \uAC78\uB824 \uB2E4\uC2DC \uC0B4 \uC218 \uC5C6\uC5B4\uC694. \uB9C8\uC744\uC5D0 \uD558\uB098\uC529 \uBAA8\uC544 \uAC00\uB294 \uC218\uC9D1 \uBAA9\uB85D\uCC98\uB7FC \uC4F0\uBA74 \uB429\uB2C8\uB2E4."
    offset: {x: 0, y: 40}
    activate:
