  tail: {fileID: 1699977787}
  openButton: {fileID: 2054620889}
  openButtonSection: "\uBA54\uC778 \uD654\uBA74"
  sectionTriggers:
  - section: "\uD658\uACBD\uC124\uC815"
    button: {fileID: 1741006732}
  - section: "\uC0C1\uC810"
    button: {fileID: 1863883205}
  - section: "\uBBF8\uB2C8\uAC8C\uC784"
    button: {fileID: 613157279}
  closeButton: {fileID: 631443444}
  prevButton: {fileID: 447924392}
  nextButton: {fileID: 495954289}
  nextButtonLabel: {fileID: 1165185841}
  stepText: {fileID: 1291619093}
  entries:
  - label: "\uACE8\uB4DC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 573615271}
    description: "<b>\uACE8\uB4DC</b>\n\uC9C0\uAE08 \uAC00\uC9C4 \uACE8\uB4DC\uC608\uC694. \uC0C1\uC810\uC5D0\uC11C \uAC74\uBB3C\uC744 \uC0AC\uB294 \uB370 \uC4F0\uACE0, \uB9C8\uC744\uC5D0 \uC138\uC6B4 \uAC74\uBB3C\uC774 1\uCD08\uB9C8\uB2E4 \uC800\uB9C8\uB2E4\uC758 \uC0DD\uC0B0\uB7C9\uB9CC\uD07C \uACE8\uB4DC\uB97C \uBC8C\uC5B4 \uC90D\uB2C8\uB2E4. \uAC74\uBB3C\uC774 \uB298\uBA74 \uC218\uC785\uB3C4 \uB298\uC5B4\uB098\uC694."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uC9C0\uC2DD \uD3EC\uC778\uD2B8"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 811000156}
    description: "<b>\uC9C0\uC2DD \uD3EC\uC778\uD2B8</b>\n\uBBF8\uB2C8\uAC8C\uC784\uC744 \uD480\uC5B4\uC11C \uBAA8\uC73C\uB294 \uC7AC\uD654\uC608\uC694. \uB79C\uB4DC\uB9C8\uD06C\uCC98\uB7FC \uACE8\uB4DC\uB9CC\uC73C\uB85C\uB294 \uC0B4 \uC218 \uC5C6\uB294 \uAC74\uBB3C\uC5D0 \uD568\uAED8 \uD544\uC694\uD569\uB2C8\uB2E4. \uD558\uB8E8\uC5D0 \uBAA8\uC744 \uC218 \uC788\uB294 \uC591\uC740 100\uD3EC\uC778\uD2B8\uAE4C\uC9C0\uC608\uC694."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uAD00\uAD11\uAC1D"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 1521806239}
    description: "<b>\uAD00\uAD11\uAC1D</b>\n'\uC9C0\uAE08 \uC628 \uAD00\uAD11\uAC1D / \uC218\uC6A9 \uD55C\uB3C4'\uC608\uC694. \uAC74\uBB3C\uC744 \uC138\uC6B0\uBA74 \uD55C\uB3C4\uAC00 \uB298\uACE0, \uAD00\uAD11\uAC1D\uC740 \uB9E4\uCD08 \uC870\uAE08\uC529 \uD55C\uB3C4\uAE4C\uC9C0 \uCC28\uC624\uB985\uB2C8\uB2E4. \uD55C\uB3C4\uC5D0 \uB2FF\uC73C\uBA74 \uB354 \uB298\uC9C0 \uC54A\uC73C\uB2C8 \uAC74\uBB3C\uB85C \uD55C\uB3C4\uB97C \uD0A4\uC6CC \uC8FC\uC138\uC694."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uC0C1\uC810 \uBC84\uD2BC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 633146533}
    description: "<b>\uC0C1\uC810</b>\n\uAC74\uBB3C\uC744 \uAD6C\uACBD\uD558\uACE0 \uC0AC\uB294 \uACF3\uC774\uC5D0\uC694. \uAE30\uBCF8 \uAC74\uBB3C\xB7\uB79C\uB4DC\uB9C8\uD06C\xB7\uC9C0\uB3C4 \uD655\uC7A5 \uD0ED\uC73C\uB85C \uB098\uB258\uC5B4 \uC788\uACE0, \uC0B0 \uAC74\uBB3C\uC740 \uBC14\uB85C \uB9C8\uC744\uC5D0 \uBC30\uCE58\uD558\uAC8C \uB429\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uBBF8\uB2C8\uAC8C\uC784 \uBC84\uD2BC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 924493840}
    description: "<b>\uBBF8\uB2C8\uAC8C\uC784</b>\n\uACBD\uBD81\uC758 \uBB38\uD654\uC7AC\uB97C \uC18C\uC7AC\uB85C \uD55C \uAC8C\uC784 4\uC885\uC774 \uB4E4\uC5B4 \uC788\uC5B4\uC694. \uBB38\uC81C\uB97C \uD480\uBA74 \uACE8\uB4DC\uC640 \uC9C0\uC2DD \uD3EC\uC778\uD2B8\uB97C \uBC1B\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uD658\uACBD\uC124\uC815 \uBC84\uD2BC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 655647647}
    description: "<b>\uD658\uACBD\uC124\uC815</b>\n\uBC30\uACBD\uC74C\uC545\xB7\uD6A8\uACFC\uC74C \uD06C\uAE30\uB97C \uC870\uC808\uD558\uACE0, \uB9C8\uC744 \uBC30\uACBD \uD14C\uB9C8\uB97C \uBC14\uAFC0 \uC218 \uC788\uC5B4\uC694."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uB3C4\uC6C0\uB9D0 \uBC84\uD2BC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 2054620888}
    description: "<b>\uB3C4\uC6C0\uB9D0</b>\n\uC9C0\uAE08 \uBCF4\uACE0 \uC788\uB294 \uC774 \uC548\uB0B4\uC608\uC694. \uD654\uBA74\uC774 \uD5F7\uAC08\uB9B4 \uB54C \uB2E4\uC2DC \uB20C\uB7EC \uCC98\uC74C\uBD80\uD130 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uC885\uB8CC \uBC84\uD2BC"
    section: "\uBA54\uC778 \uD654\uBA74"
    target: {fileID: 905800771}
    description: "<b>\uAC8C\uC784 \uC885\uB8CC</b>\n\uD655\uC778 \uCC3D\uC744 \uB744\uC6B0\uACE0, [\uAC8C\uC784 \uC885\uB8CC]\uB97C \uB204\uB974\uBA74 \uC9C4\uD589 \uC0C1\uD669\uC744 \uC800\uC7A5\uD55C \uB4A4 \uAC8C\uC784\uC744 \uB05D\uB0C5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate: []
    deactivate: []
  - label: "\uD658\uACBD\uC124\uC815 \uD0ED"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519280}
    description: "<b>\uD658\uACBD\uC124\uC815</b>\n\uC704\uCABD \uD0ED\uC73C\uB85C \uD654\uBA74\uC744 \uBC14\uAFC9\uB2C8\uB2E4. [\uAE30\uBCF8 \uC124\uC815]\uC740 \uC18C\uB9AC, [\uD14C\uB9C8 \uC124\uC815]\uC740 \uB9C8\uC744 \uBC30\uACBD\uC744 \uB2E4\uB904\uC694."
    offset: {x: 0, y: 56}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519279}
    deactivate:
    - {fileID: 543519278}
    - {fileID: 543519275}
  - label: "\uBC30\uACBD\uC74C\uC545 \uD06C\uAE30"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519273}
    description: "<b>\uBC30\uACBD\uC74C\uC545 \uD06C\uAE30</b>\n\uB9C9\uB300\uB97C \uB04C\uC5B4 \uBC30\uACBD\uC74C\uC545 \uD06C\uAE30\uB97C 0~100\uC73C\uB85C \uB9DE\uCDB0\uC694. \uC6C0\uC9C1\uC774\uB294 \uC989\uC2DC \uC18C\uB9AC\uC5D0 \uBC18\uC601\uB418\uACE0, \uCC3D\uC744 \uB2EB\uC744 \uB54C \uC800\uC7A5\uB429\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519279}
    deactivate:
    - {fileID: 543519278}
    - {fileID: 543519275}
  - label: "\uD6A8\uACFC\uC74C \uD06C\uAE30"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519272}
    description: "<b>\uD6A8\uACFC\uC74C \uD06C\uAE30</b>\n\uBC84\uD2BC \uC18C\uB9AC\uCC98\uB7FC \uC9E7\uAC8C \uB098\uB294 \uC18C\uB9AC\uC758 \uD06C\uAE30\uC608\uC694. \uBC30\uACBD\uC74C\uC545\uACFC \uB530\uB85C \uC870\uC808\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519279}
    deactivate:
    - {fileID: 543519278}
    - {fileID: 543519275}
  - label: "\uC74C\uC18C\uAC70 \uBC84\uD2BC"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519274}
    description: "<b>\uC74C\uC18C\uAC70</b>\n\uC2A4\uD53C\uCEE4 \uC544\uC774\uCF58\uC744 \uB204\uB974\uBA74 \uADF8 \uC18C\uB9AC\uB9CC \uB055\uB2C8\uB2E4. \uC544\uC774\uCF58 \uBAA8\uC591\uC740 \uD604\uC7AC \uD06C\uAE30\uC5D0 \uB530\uB77C \uBC14\uB00C\uACE0, \uC74C\uC18C\uAC70 \uC911\uC5D0 \uB9C9\uB300\uB97C \uC6C0\uC9C1\uC774\uBA74 \uC790\uB3D9\uC73C\uB85C \uB2E4\uC2DC \uCF1C\uC838\uC694."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519279}
    deactivate:
    - {fileID: 543519278}
    - {fileID: 543519275}
  - label: "\uD14C\uB9C8 \uBAA9\uB85D"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519277}
    description: "<b>\uD14C\uB9C8 \uC124\uC815</b>\n\uB9C8\uC744 \uBC30\uACBD\uC744 \uACE0\uB974\uB294 \uACF3\uC774\uC5D0\uC694. \uC5F4\uB9B0 \uD14C\uB9C8\uB294 \uB20C\uB7EC\uC11C \uBC14\uB85C \uC801\uC6A9\uB418\uACE0, \uC7A0\uAE34 \uD14C\uB9C8\uB294 \uADF8 \uD14C\uB9C8\uAC00 \uAC00\uB9AC\uD0A4\uB294 \uC2E4\uC81C \uC7A5\uC18C \uADFC\uCC98\uC5D0\uC11C [\uC778\uC99D]\uC744 \uB20C\uB7EC\uC57C \uC5F4\uB9BD\uB2C8\uB2E4."
    offset: {x: 0, y: 56}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519278}
    deactivate:
    - {fileID: 543519279}
    - {fileID: 543519275}
  - label: "\uD14C\uB9C8 \uC548\uB0B4 \uBB38\uAD6C"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519276}
    description: "<b>\uC778\uC99D \uC548\uB0B4</b>\n\uD14C\uB9C8\uB97C \uC801\uC6A9\uD588\uB294\uC9C0, \uC704\uCE58 \uC778\uC99D\uC774 \uB410\uB294\uC9C0 \uACB0\uACFC\uAC00 \uC5EC\uAE30\uC5D0 \uD45C\uC2DC\uB3FC\uC694. \uC778\uC99D\uC5D0\uB294 \uD734\uB300\uD3F0\uC758 \uC704\uCE58 \uC815\uBCF4\uB97C \uC501\uB2C8\uB2E4."
    offset: {x: 0, y: 44}
    activate:
    - {fileID: 543519270}
    - {fileID: 543519278}
    deactivate:
    - {fileID: 543519279}
    - {fileID: 543519275}
  - label: "\uD658\uACBD\uC124\uC815 \uB2EB\uAE30"
    section: "\uD658\uACBD\uC124\uC815"
    target: {fileID: 543519271}
    description: "<b>\uB2EB\uAE30</b>\n\uD658\uACBD\uC124\uC815\uC744 \uB2EB\uACE0 \uB9C8\uC744\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4. \uC774\uB54C \uC18C\uB9AC \uC124\uC815\uC774 \uD30C\uC77C\uC5D0 \uC800\uC7A5\uB3FC\uC694."
    offset: {x: 0, y: 44}
