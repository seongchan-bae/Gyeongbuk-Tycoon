  m_Name: "\uC131\uB355\uB300\uC655\uC2E0\uC885"
  m_EditorClassIdentifier: Assembly-CSharp::BuildingData
  buildingName: "\uC131\uB355\uB300\uC655\uC2E0\uC885"
  price: 100000
