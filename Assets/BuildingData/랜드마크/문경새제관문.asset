  m_Name: "\uBB38\uACBD\uC0C8\uC81C\uAD00\uBB38"
  m_EditorClassIdentifier: Assembly-CSharp::BuildingData
  buildingName: "\uBB38\uACBD\uC0C8\uC7AC\uAD00\uBB38"
  price: 100
